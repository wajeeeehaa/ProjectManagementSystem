# Database connection. Leave blank until you set the local Postgres user and password.
# Database name: projectmanagementsystem
DATABASE_URL=

# Port the API listens on. Required. No default.
SERVER_PORT=

# Network interface the API binds to. Required. No default.
# 127.0.0.1 binds to the IPv4 loopback interface.
# 0.0.0.0 binds to all IPv4 network interfaces.
SERVER_HOST=

# Comma-separated browser origins allowed by CORS. Required. No default.
CORS_ORIGINS=

# Checked only when a token is verified. Not required for the scaffold to start.
# HS256 uses JWT_SECRET. RS256 uses JWT_PUBLIC_KEY.
JWT_ALGORITHM=
JWT_SECRET=
JWT_PUBLIC_KEY=

# Cookie name read from the Cookie header when Authorization Bearer is absent.
# If blank, the cookie is not read.
ACCESS_TOKEN_COOKIE_NAME=
