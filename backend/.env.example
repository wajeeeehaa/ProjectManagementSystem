# Database connection. Database name: projectmanagementsystem
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/projectmanagementsystem

# Port the API listens on. Required. No default.
SERVER_PORT=4000

# Network interface the API binds to. Required. No default.
# 127.0.0.1 binds to the IPv4 loopback interface.
# 0.0.0.0 binds to all IPv4 network interfaces.
SERVER_HOST=127.0.0.1

# Activity live updates use WebSocket path /api/activity/stream on this server.
# The browser Origin must be listed in CORS_ORIGINS. Next.js does not proxy this upgrade.

# Comma-separated browser origins allowed by CORS. Required. No default.
# With the Next.js rewrite, browser calls are same-origin. Keep the frontend origin for direct API clients.
CORS_ORIGINS=http://localhost:3000

# HMAC secret used for access, refresh, activation, and reset tokens. Not an RSA private key.
# Required. At least 32 characters. No default.
JWT_SECRET=replace-with-a-random-string-at-least-32-characters

# Access and refresh lifetimes. Required. Examples: 15m, 7d. No default.
JWT_ACCESS_EXPIRATION_TIME=15m
JWT_REFRESH_EXPIRATION_TIME=7d

# Absolute frontend origin used in activation and reset links. Required. No default.
FRONTEND_URL=http://localhost:3000

# Cookie flags. In production, startup fails unless SECURE_COOKIE=true and SAME_SITE is lax or strict.
SECURE_COOKIE=false
SAME_SITE=lax

# SMTP for activation, reset, and password-change messages. Host, port, and from are required.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost

# Shared window and maximum for register, login, activation resend, verification, and reset-link requests.
# Keys combine client IP with the normalized email, or with a hash of the activation token.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# How often expired blacklist rows and expired refresh sessions are deleted.
CLEANUP_INTERVAL_MS=900000
