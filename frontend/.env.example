# Base URL of this API. Required when a request is made. No default.
NEXT_PUBLIC_API_URL=

# Auth service URL. Not used until login is implemented.
NEXT_PUBLIC_AUTH_API_URL=

# localStorage key for the access token. If blank, localStorage is not used.
NEXT_PUBLIC_ACCESS_TOKEN_STORAGE_KEY=

# JS cookie name for the access token. If blank, the cookie is not used.
NEXT_PUBLIC_ACCESS_TOKEN_COOKIE_NAME=

# Cookie max-age in seconds. If blank, the cookie is not written.
NEXT_PUBLIC_ACCESS_TOKEN_MAX_AGE=
