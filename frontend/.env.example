# Leave empty so browser requests stay on this origin. Next.js proxies /api to the API.
NEXT_PUBLIC_API_URL=

# Direct WebSocket URL for live activity. Next.js rewrites do not forward WebSocket upgrades.
# Use the same hostname as the page so the access cookie is sent. For http://localhost:3000:
NEXT_PUBLIC_WS_URL=ws://localhost:4000/api/activity/stream

# Required server-side destination for the /api rewrite. No default.
# Production should instead put the UI and /api behind one reverse proxy and host.
API_PROXY_TARGET=http://127.0.0.1:4000
